                </mxCell>
                <mxCell id="wE4C6WDopIEsvahnlwJd-14" value="It's essentially just a rectangle with a position, width and height&lt;br&gt;&lt;br&gt;Calling it to be drawn, will draw all the components attached to the file" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="wE4C6WDopIEsvahnlwJd-17" vertex="1">
                    <mxGeometry x="130" y="50" width="140" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="wE4C6WDopIEsvahnlwJd-34" value="The actual pixel dimensions of the component is relative to the the panel&lt;br&gt;&lt;br&gt;Which are calculate using the component's points and the dimensions of the panel&lt;br&gt;&lt;br&gt;Components dont know or care for other components on the same space, they only care to keep themselves inside the panel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
