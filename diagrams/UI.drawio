                <mxCell id="wE4C6WDopIEsvahnlwJd-2" value="A panel defines a space on the screen, which components should be drawn" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="wE4C6WDopIEsvahnlwJd-17" vertex="1">
