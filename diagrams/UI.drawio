                <mxCell id="wE4C6WDopIEsvahnlwJd-7" value="A component is something made to be drawn onto a panel. It also has a rectangle, but defined as 4 floating point values between 0 and 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="wE4C6WDopIEsvahnlwJd-16" vertex="1">
