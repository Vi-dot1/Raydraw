                <mxCell id="wE4C6WDopIEsvahnlwJd-15" value="This four points define a percentages for in which point the left, right, up and down of the component are placed inside a panel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="wE4C6WDopIEsvahnlwJd-16" vertex="1">
